<Project Sdk="Microsoft.NET.Sdk">

  <!-- New F# tests for the async family (plan step 3). -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AsyncRoundTripTests.fs" />
    <Compile Include="GoldenMasterTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real, scrubbed production Atom feeds (content payloads removed). Copied
         next to the test assembly so the golden-master tests can read them. -->
    <Content Include="Fixtures\**\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Unquote" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AtomEventStore\AtomEventStore.csproj" />
  </ItemGroup>

</Project>
