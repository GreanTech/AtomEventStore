<Project Sdk="Microsoft.NET.Sdk">

  <!-- Modernized F# test suite: synchronous round-trips, DataContract DU
       scenarios, and the user-sign-up demo. SDK-style net8.0 / xUnit 2 /
       AutoFixture 4 / Unquote 7. (Rx is no longer needed.) -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Grean.AtomEventStore.UnitTests.FSharp</RootNamespace>
    <AssemblyName>Grean.AtomEventStore.UnitTests.FSharp</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Records.fs" />
    <Compile Include="TestDsl.fs" />
    <Compile Include="XmlEventStreamFacadeTests.fs" />
    <Compile Include="DataContractEventsFacadeTests.fs" />
    <Compile Include="UserSignUpDemo.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="AutoFixture" Version="4.18.1" />
    <PackageReference Include="AutoFixture.Xunit2" Version="4.18.1" />
    <PackageReference Include="Unquote" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AtomEventStore\AtomEventStore.csproj" />
  </ItemGroup>

</Project>
