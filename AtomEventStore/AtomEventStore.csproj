<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Grean.AtomEventStore</RootNamespace>
    <AssemblyName>Grean.AtomEventStore</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Quality gate (plan step 5): .NET analyzers + warnings-as-errors.
         Rule severities (and the few deliberately-disabled rules ported from the
         legacy AtomEventStore.ruleset) live in the repo-root .editorconfig. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provides IAsyncEnumerable<T>/IAsyncDisposable on netstandard2.0 for the
         async read API (AsyncFifoEvents/AsyncLifoEvents). -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

  <!-- Package / assembly metadata migrated from the retired AssemblyInfo.cs and
       nuspec. PackageId is pinned to the historically-published id ("AtomEventStore",
       per the README's NuGet link) so 2.0 updates the existing package rather than
       creating a new one; the assembly name stays Grean.AtomEventStore as before. -->
  <PropertyGroup>
    <PackageId>AtomEventStore</PackageId>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Title>Atom Event Store</Title>
    <Description>Event store implementation based on the Atom syndication format.</Description>
    <Authors>Grean ApS</Authors>
    <Company>Grean ApS</Company>
    <Product>AtomEventStore</Product>
    <Copyright>Copyright © Grean ApS</Copyright>
    <PackageProjectUrl>https://github.com/GreanTech/AtomEventStore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/GreanTech/AtomEventStore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>EventSourcing;Atom;EventStore</PackageTags>
  </PropertyGroup>

</Project>
